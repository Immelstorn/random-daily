# Copy this file to config.env and fill in the values.
# config.env is gitignored and should be chmod 600.

# Comma-separated list of standup members (no spaces).
MEMBERS="Javier,Anton,Michael,Denys"

# Slack workflow webhook URL (https://hooks.slack.com/triggers/...).
WEBHOOK_URL="https://hooks.slack.com/triggers/REPLACE_ME"
